{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "npm: watch",
      "env": {
        // The daemon is never installed for development; point F5 at the sibling engine's Debug build.
        "MAILCODED_DAEMON": "${workspaceFolder}/../mailcoded/src/Mailcoded.Daemon/bin/Debug/net10.0/mailcoded-daemon"
      }
    }
  ]
}
