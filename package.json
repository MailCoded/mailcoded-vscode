{
  "name": "mailcoded",
  "displayName": "Mailcoded",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "mailcoded",
  "license": "MIT",
  "author": "Yu Lin (@lywedo)",
  "repository": {
    "type": "git",
    "url": "https://github.com/MailCoded/mailcoded-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/MailCoded/mailcoded-vscode/issues"
  },
  "homepage": "https://github.com/MailCoded/mailcoded-vscode#readme",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "email",
    "mail",
    "imap",
    "smtp",
    "mailcoded"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.untrustedWorkspaces.description%",
      "restrictedConfigurations": [
        "mailcoded.daemonPath",
        "mailcoded.dataDir"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "%capabilities.virtualWorkspaces.description%"
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mailcoded",
          "title": "%viewsContainer.mailcoded.title%",
          "icon": "media/mail.svg"
        }
      ]
    },
    "views": {
      "mailcoded": [
        {
          "id": "mailcoded.accounts",
          "name": "%view.accounts.name%"
        },
        {
          "id": "mailcoded.messages",
          "name": "%view.messages.name%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "mailcoded.accounts",
        "contents": "%welcome.connected%",
        "when": "mailcoded.state == 'ready' || mailcoded.state == 'secondary'"
      },
      {
        "view": "mailcoded.accounts",
        "contents": "%welcome.noAccounts%",
        "when": "mailcoded.state == 'noAccounts'"
      },
      {
        "view": "mailcoded.accounts",
        "contents": "%welcome.starting%",
        "when": "mailcoded.state == 'starting' || mailcoded.state == 'restarting'"
      },
      {
        "view": "mailcoded.accounts",
        "contents": "%welcome.daemonMissing%",
        "when": "mailcoded.state == 'daemonMissing'"
      },
      {
        "view": "mailcoded.accounts",
        "contents": "%welcome.protocolMismatch%",
        "when": "mailcoded.state == 'protocolMismatch'"
      },
      {
        "view": "mailcoded.accounts",
        "contents": "%welcome.failed%",
        "when": "mailcoded.state == 'failed'"
      },
      {
        "view": "mailcoded.messages",
        "contents": "%view.messages.welcome%"
      }
    ],
    "commands": [
      {
        "command": "mailcoded.sync",
        "title": "%command.sync.title%",
        "category": "Mailcoded",
        "icon": "$(sync)"
      },
      {
        "command": "mailcoded.syncFolder",
        "title": "%command.syncFolder.title%",
        "category": "Mailcoded",
        "icon": "$(sync)"
      },
      {
        "command": "mailcoded.refresh",
        "title": "%command.refresh.title%",
        "category": "Mailcoded",
        "icon": "$(refresh)"
      },
      {
        "command": "mailcoded.openFolder",
        "title": "%command.openFolder.title%",
        "category": "Mailcoded"
      },
      {
        "command": "mailcoded.openMessage",
        "title": "%command.openMessage.title%",
        "category": "Mailcoded"
      },
      {
        "command": "mailcoded.loadMore",
        "title": "%command.loadMore.title%",
        "category": "Mailcoded",
        "icon": "$(ellipsis)"
      },
      {
        "command": "mailcoded.search",
        "title": "%command.search.title%",
        "category": "Mailcoded",
        "icon": "$(search)"
      },
      {
        "command": "mailcoded.markRead",
        "title": "%command.markRead.title%",
        "category": "Mailcoded",
        "icon": "$(mail-read)"
      },
      {
        "command": "mailcoded.markUnread",
        "title": "%command.markUnread.title%",
        "category": "Mailcoded",
        "icon": "$(mail)"
      },
      {
        "command": "mailcoded.toggleFlag",
        "title": "%command.toggleFlag.title%",
        "category": "Mailcoded",
        "icon": "$(star)"
      },
      {
        "command": "mailcoded.showDaemonLog",
        "title": "%command.showDaemonLog.title%",
        "category": "Mailcoded",
        "icon": "$(output)"
      },
      {
        "command": "mailcoded.showDaemonInfo",
        "title": "%command.showDaemonInfo.title%",
        "category": "Mailcoded",
        "icon": "$(info)"
      },
      {
        "command": "mailcoded.restartDaemon",
        "title": "%command.restartDaemon.title%",
        "category": "Mailcoded",
        "icon": "$(debug-restart)"
      },
      {
        "command": "mailcoded.viewHtml",
        "title": "%command.viewHtml.title%",
        "category": "Mailcoded",
        "icon": "$(code)"
      },
      {
        "command": "mailcoded.viewPlainText",
        "title": "%command.viewPlainText.title%",
        "category": "Mailcoded",
        "icon": "$(symbol-text)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mailcoded.sync",
          "when": "view == mailcoded.accounts",
          "group": "navigation@1"
        },
        {
          "command": "mailcoded.refresh",
          "when": "view == mailcoded.accounts",
          "group": "navigation@2"
        },
        {
          "command": "mailcoded.showDaemonLog",
          "when": "view == mailcoded.accounts",
          "group": "1_daemon@2"
        },
        {
          "command": "mailcoded.showDaemonInfo",
          "when": "view == mailcoded.accounts",
          "group": "1_daemon@3"
        },
        {
          "command": "mailcoded.restartDaemon",
          "when": "view == mailcoded.accounts",
          "group": "1_daemon@4"
        },
        {
          "command": "mailcoded.search",
          "when": "view == mailcoded.messages",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "mailcoded.syncFolder",
          "when": "view == mailcoded.accounts && viewItem == folder",
          "group": "1_sync@1"
        },
        {
          "command": "mailcoded.markRead",
          "when": "view == mailcoded.messages && viewItem == message.unread",
          "group": "1_triage@1"
        },
        {
          "command": "mailcoded.markUnread",
          "when": "view == mailcoded.messages && viewItem == message.read",
          "group": "1_triage@1"
        },
        {
          "command": "mailcoded.toggleFlag",
          "when": "view == mailcoded.messages && (viewItem == message.unread || viewItem == message.read)",
          "group": "1_triage@2"
        }
      ],
      "commandPalette": [
        {
          "command": "mailcoded.syncFolder",
          "when": "false"
        },
        {
          "command": "mailcoded.openFolder",
          "when": "false"
        },
        {
          "command": "mailcoded.openMessage",
          "when": "false"
        },
        {
          "command": "mailcoded.loadMore",
          "when": "false"
        },
        {
          "command": "mailcoded.viewHtml",
          "when": "false"
        },
        {
          "command": "mailcoded.viewPlainText",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "mailcoded.viewHtml",
          "when": "activeWebviewPanelId == 'mailcoded.reader'",
          "group": "navigation@1"
        },
        {
          "command": "mailcoded.viewPlainText",
          "when": "activeWebviewPanelId == 'mailcoded.reader'",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Mailcoded",
      "properties": {
        "mailcoded.daemonPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.daemonPath.description%"
        },
        "mailcoded.dataDir": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.dataDir.description%"
        },
        "mailcoded.pageSize": {
          "type": "integer",
          "default": 50,
          "minimum": 10,
          "maximum": 200,
          "description": "%config.pageSize.description%"
        },
        "mailcoded.markReadOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "%config.markReadOnOpen.description%"
        },
        "mailcoded.readerDefault": {
          "type": "string",
          "default": "text",
          "enum": [
            "text",
            "html"
          ],
          "enumDescriptions": [
            "%config.readerDefault.text%",
            "%config.readerDefault.html%"
          ],
          "description": "%config.readerDefault.description%"
        },
        "mailcoded.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "off",
            "error",
            "warn",
            "info",
            "debug"
          ],
          "enumDescriptions": [
            "%config.logLevel.off%",
            "%config.logLevel.error%",
            "%config.logLevel.warn%",
            "%config.logLevel.info%",
            "%config.logLevel.debug%"
          ],
          "description": "%config.logLevel.description%"
        },
        "mailcoded.quoteLines": {
          "type": "integer",
          "default": 200,
          "minimum": 0,
          "description": "%config.quoteLines.description%"
        },
        "mailcoded.threadGrouping": {
          "type": "boolean",
          "default": true,
          "description": "%config.threadGrouping.description%"
        },
        "mailcoded.pollIntervalSeconds": {
          "type": "integer",
          "default": 60,
          "minimum": 15,
          "description": "%config.pollIntervalSeconds.description%"
        }
      }
    },
    "languages": [
      {
        "id": "mailcoded-compose",
        "aliases": [
          "Mail draft"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mailcoded-compose",
        "scopeName": "text.mailcoded-compose",
        "path": "./syntaxes/mailcoded-compose.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[mailcoded-compose]": {
        "editor.wordWrap": "on",
        "editor.minimap.enabled": false,
        "editor.quickSuggestions": false
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:production",
    "build": "node esbuild.mjs",
    "build:production": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:invariants": "node scripts/lint-invariants.mjs",
    "license-check": "node scripts/license-check.mjs",
    "test:unit": "mocha --import tsx \"test/unit/**/*.test.ts\"",
    "test:sanitize": "mocha --import tsx \"test/sanitize/**/*.test.ts\"",
    "test:e2e": "node test/e2e/runTest.js",
    "smoke:daemon": "tsx --import ./test/mock-daemon/vscodeAlias.mjs test/real-daemon-smoke.ts",
    "package": "vsce package --no-dependencies",
    "sync:protocol": "node scripts/sync-protocol.mjs",
    "smoke:webview": "tsx test/webview-smoke.ts"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "vscode-jsonrpc": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "@types/vscode": "~1.96.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "mocha": "^12.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.69.0"
  }
}
